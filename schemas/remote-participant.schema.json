{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synth:schema:remote-participant:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "enum": ["urn:synth:schema:remote-participant:0.1.0", "urn:synth:schema:remote-participant:0.2.0"] },
    "schema_version": { "enum": ["0.1.0", "0.2.0"] },
    "identity": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "identity_assurance": { "enum": ["UNVERIFIED", "VERIFIED"] },
    "verification_method": { "enum": ["http-content-marker", "ed25519-signed-manifest-v1"] },
    "public_key_pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" },
    "public_key_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "registered_at": { "type": "string", "format": "date-time" },
    "provides": {
      "type": "object", "additionalProperties": false,
      "properties": { "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } } },
      "required": ["surfaces"]
    }
  },
  "$defs": {
    "surface": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "kind", "media_type"]
    }
  },
  "required": ["$schema", "schema_version", "identity", "version", "description", "endpoint", "identity_assurance", "verification_method", "provides"],
  "allOf": [{
    "if": { "properties": { "identity_assurance": { "const": "VERIFIED" } } },
    "then": {
      "properties": {
        "$schema": { "const": "urn:synth:schema:remote-participant:0.2.0" },
        "schema_version": { "const": "0.2.0" },
        "verification_method": { "const": "ed25519-signed-manifest-v1" }
      },
      "required": ["public_key_pem", "public_key_fingerprint"]
    },
    "else": {
      "properties": { "verification_method": { "const": "http-content-marker" } }
    }
  }]
}
