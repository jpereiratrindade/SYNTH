{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synth:schema:remote-participant:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "urn:synth:schema:remote-participant:0.1.0" },
    "schema_version": { "const": "0.1.0" },
    "identity": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "identity_assurance": { "const": "UNVERIFIED" },
    "verification_method": { "const": "http-content-marker" },
    "registered_at": { "type": "string", "format": "date-time" },
    "provides": {
      "type": "object", "additionalProperties": false,
      "properties": { "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } } },
      "required": ["surfaces"]
    }
  },
  "$defs": {
    "surface": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "kind", "media_type"]
    }
  },
  "required": ["$schema", "schema_version", "identity", "version", "description", "endpoint", "identity_assurance", "verification_method", "provides"]
}
