{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synth:schema:relation:0.1.0",
  "title": "SYNTH observed relation",
  "description": "Portable representation of a relation factually observed by SYNTH.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "epistemic_class": {
      "type": "string",
      "enum": ["DECLARED", "OBSERVED", "DERIVED"]
    },
    "observation": { "type": "string", "const": "runtime_witness" },
    "assertion": { "type": "string", "const": "consumed_surface" },
    "assertion_mode": { "type": "string", "const": "participant_attestation" },
    "expected_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attested_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verification": { "type": "string", "const": "MATCH" },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  },
  "required": [
    "id",
    "source",
    "target",
    "surface",
    "status",
    "epistemic_class",
    "observation",
    "assertion",
    "assertion_mode",
    "expected_sha256",
    "attested_sha256",
    "verification",
    "evidence_ref",
    "observed_at"
  ]
}
