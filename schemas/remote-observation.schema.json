{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synth:schema:remote-observation:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "enum": ["urn:synth:schema:remote-observation:0.1.0", "urn:synth:schema:remote-observation:0.2.0"] },
    "schema_version": { "enum": ["0.1.0", "0.2.0"] },
    "identity": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "availability": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
    "identity_assurance": { "enum": ["UNVERIFIED", "VERIFIED"] },
    "verification_method": { "enum": ["http-content-marker", "ed25519-signed-manifest-v1"] },
    "identity_statement": { "$ref": "#/$defs/identity_statement" },
    "signature_base64": { "type": "string", "minLength": 80, "maxLength": 100 },
    "observer": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "detail": { "type": "string", "minLength": 1 },
    "observed_surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } }
  },
  "$defs": {
    "identity_statement": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "identity": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["identity", "version", "endpoint", "issued_at", "expires_at"]
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "format": "uri" },
        "direction": { "enum": ["inbound", "outbound", "bidirectional"] },
        "media_type": { "type": "string", "minLength": 1 },
        "observability": { "const": "remote-observer-attestation" },
        "metadata": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "owner", "kind", "locator", "direction", "media_type", "observability", "metadata"]
    }
  },
  "required": ["$schema", "schema_version", "identity", "endpoint", "availability", "identity_assurance", "verification_method", "observer", "observed_at", "expires_at", "detail", "observed_surfaces"],
  "allOf": [{
    "if": { "properties": { "identity_assurance": { "const": "VERIFIED" } } },
    "then": {
      "properties": {
        "$schema": { "const": "urn:synth:schema:remote-observation:0.2.0" },
        "schema_version": { "const": "0.2.0" },
        "verification_method": { "const": "ed25519-signed-manifest-v1" }
      },
      "required": ["identity_statement", "signature_base64"]
    },
    "else": { "properties": { "verification_method": { "const": "http-content-marker" } } }
  }]
}
