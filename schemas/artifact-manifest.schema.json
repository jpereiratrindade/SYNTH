{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synth:schema:artifact-manifest:0.1.0",
  "title": "SYNTH realizable artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "urn:synth:schema:artifact-manifest:0.1.0" },
    "schema_version": { "const": "0.1.0" },
    "identity": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "media_type": { "const": "application/x-tar" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["path", "media_type", "sha256"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      },
      "required": ["source", "revision", "license"]
    },
    "provides": { "$ref": "#/$defs/surfaceSet" },
    "requires": { "$ref": "#/$defs/surfaceSet" },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "environment_allowed": {
          "type": "array",
          "items": {
            "enum": ["SYNTH_REALIZATION_ID", "SYNTH_WITNESS_PATH", "SYNTH_RESOLVED_SURFACES_PATH", "SYNTH_ECOSYSTEM_STREAM"]
          },
          "uniqueItems": true
        }
      },
      "required": ["entrypoint", "arguments", "environment_allowed"]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "command" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 }
      },
      "required": ["type", "entrypoint", "arguments", "timeout_ms"]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activation_rss_mib_max": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 }
      },
      "required": ["id"],
      "allOf": [
        {
          "if": {
            "properties": { "id": { "const": "interface.human.web.v1" } },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "kind": { "const": "http" },
              "media_type": { "const": "text/html" }
            },
            "required": ["kind", "media_type"]
          }
        }
      ]
    },
    "surfaceSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } }
      },
      "required": ["surfaces"]
    }
  },
  "required": [
    "$schema", "schema_version", "identity", "version", "description",
    "artifact", "provenance", "provides", "requires", "realization",
    "readiness", "resources"
  ]
}
